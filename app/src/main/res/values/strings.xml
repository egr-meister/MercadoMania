    <!-- Privacy policy text shown in-app (offline, no network) -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">Mercado Mania works completely offline.\n\n• The app requests no permissions and has no internet access.\n• Your best scores and your sound setting are stored only on this device.\n• Nothing is collected, uploaded, shared or sold.\n• Resetting progress in Settings removes everything the app has stored.</string>

    <!-- Rules -->
    <string name="rules_title">Game Rules</string>
    <string name="rules_quiz_header">Quiz</string>
    <string name="rules_quiz_body">Pick a category and answer ten questions, one at a time. Tap an answer and the correct option lights up green with a check mark; a wrong pick turns red with a cross. The next question arrives on its own. Your best score per category is kept.</string>
    <string name="rules_pairs_header">Matching Pairs</string>
    <string name="rules_pairs_body">Flip two cards per turn. A matching pair stays open; anything else flips back. Clear every pair before the timer runs out to win the level. Each level you clear unlocks the next one, and your best number of matched pairs is kept per level.</string>
    <string name="rules_general_header">Good to know</string>
    <string name="rules_general_body">Pause at any time with the pause button — the timer stops with you. Everything is saved on this device, and Settings lets you wipe it all whenever you like.</string>

